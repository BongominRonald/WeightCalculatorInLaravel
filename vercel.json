{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "outputDirectory": "public",

    "installCommand": "composer install --no-interaction --prefer-dist --no-dev --optimize-autoloader && npm ci",

    "buildCommand": "npm run build && php artisan migrate --force",

    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },

    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ],

    "headers": [
        {
            "source": "/build/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)\\.(svg|ico|png|jpg|jpeg|gif|webp)$",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                }
            ]
        }
    ]
}
